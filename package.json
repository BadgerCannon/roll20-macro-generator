{
  "name": "roll20-macro-generator",
  "version": "0.1.0",
  "description": "Generate Roll20 macros from a YAML DSL, with automatic escaping and linting",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "gen:schema": "tsx scripts/gen-schema.ts",
    "check:schema": "tsx scripts/gen-schema.ts --check",
    "build:cli": "tsup",
    "r20m": "tsx src/cli/index.ts",
    "dev": "vite",
    "build:web": "npm run gen:schema && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "codemirror-json-schema": "^0.8.1",
    "lz-string": "^1.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "bin": {
    "r20m": "dist/cli/index.js"
  }
}
